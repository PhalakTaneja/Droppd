# droppd configuration.
# Copy this file to .env and fill in your values.
# .env is gitignored: your secrets never leave this machine.

# Your Telegram bot token, from @BotFather (send /newbot).
TELEGRAM_BOT_TOKEN=

# Leave empty for now; run `python3 bot.py setup` to discover yours.
TELEGRAM_CHAT_ID=

# Free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-flash-lite-latest)
# GEMINI_MODEL=
